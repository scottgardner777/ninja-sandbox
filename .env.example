# Ninja Sandbox .env  (copy to .env). Everything optional; defaults = self-hosted, loopback-only, telemetry OFF.

# Where the UI listens. Keep 127.0.0.1 unless you set SANDBOX_TOKEN (then the UI/API require X-Sandbox-Token).
SANDBOX_BIND=127.0.0.1
SANDBOX_PORT=8800
SANDBOX_TOKEN=

# Mode: self-hosted | ninja-hosted | hybrid  (changes telemetry default and the UI footer; nothing else is hidden)
SANDBOX_MODE=self-hosted

# Raz0r Sensor input
#   file    : SENSOR_LOG_HOST = the directory holding your proxy's access log(s); SENSOR_LOG_PATHS inside the container
#   syslog  : point the proxy at this box :5514 (Caddy: log { output net udp/HOST:5514 } ; nginx: access_log syslog:server=HOST:5514 combined;)
#   inline  : SENSOR_UPSTREAM = the app behind it; the sensor listens on :8080 and logs every request
SENSOR_INPUT=file
SENSOR_FORMAT=auto
SENSOR_LOG_HOST=./data/logs
SENSOR_LOG_PATHS=/logs/access.log
SENSOR_SYSLOG_BIND=127.0.0.1
SENSOR_INLINE_BIND=127.0.0.1
SENSOR_UPSTREAM=http://127.0.0.1:3000
# Your own addresses/CIDRs, comma-separated: never profiled, never sent
SENSOR_EXCLUDE=

# Samples dropped into this host directory are triaged automatically (a honeypot's download dir, a quarantine folder)
SENSOR_WATCH_HOST=./data/watch

# Cell: the internal network the sample lives on
SANDBOX_CELL_NET=sandbox-cell
SANDBOX_CELL_SUBNET=10.66.0.0/24
SANDBOX_MAX_SAMPLE_MB=32
